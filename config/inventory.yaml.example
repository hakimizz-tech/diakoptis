---
# Asterfusion CLI - Inventory Example
# Instructions:
# 1. Copy this file to `inventory.yaml`.
# 2. Add your lab or production switches below.
# 3. Do NOT put plaintext passwords in this file. The CLI's config loader will 
#    automatically resolve values starting with "ENV:" from your environment vars.


# Global Defaults
# Applied to all switches unless explicitly overridden at the group or host level.
defaults:
  device_type: "asterfusion_asternos"
  port: 22
  # Credential References (maps to .env file)
  username: "ENV:ASTER_CLI_USERNAME"
  password: "ENV:ASTER_CLI_PASSWORD"
  secret: "ENV:ASTER_CLI_SECRET"

# Switch Inventory
# Group your switches by site, role, or environment for easier multi-device targets
groups:
  # Example: A pair of production leaf switches
  fabric_leaves:
    hosts:
      leaf01:
        hostname: "10.10.1.11"        # Can be an IP address or FQDN
        description: "ToR Switch Rack 1"
      
      leaf02:
        hostname: "10.10.1.12"
        description: "ToR Switch Rack 2"

  # Example: A lab environment using different credentials and ports
  lab_switches:
    # Overriding the global defaults for this specific group
    port: 2222
    username: "ENV:LAB_CLI_USERNAME"
    password: "ENV:LAB_CLI_PASSWORD"
    
    hosts:
      lab-leaf01:
        hostname: "192.168.100.51"
        description: "Test bench Asterfusion box"
        
      # Example of overriding device_type for a specific host if you have a 
      # mixed environment (e.g., testing standard enterprise SONiC vs AsterNOS)
      lab-spine01:
        hostname: "192.168.100.10"
        device_type: "mellanox_sonic"