Value Required INTERFACE (\S+)
Value LANES (\S+)
Value SPEED (\S+)
Value MTU (\d+)
Value FEC (\S+)
Value ALIAS (\S+)
Value OPER_STATUS (\S+)
Value ADMIN_STATUS (\S+)
Value OPTICAL_TYPE (\S+)
Value ASYM_PFC (\S+)
Value IF_TYPE (\S+)

Start
  # Match the row, allowing for leading spaces, and make IF_TYPE optional at the end
  ^\s*${INTERFACE}\s+${LANES}\s+${SPEED}\s+${MTU}\s+${FEC}\s+${ALIAS}\s+${OPER_STATUS}\s+${ADMIN_STATUS}\s+${OPTICAL_TYPE}\s+${ASYM_PFC}(?:\s+${IF_TYPE})?\s*$$ -> Record