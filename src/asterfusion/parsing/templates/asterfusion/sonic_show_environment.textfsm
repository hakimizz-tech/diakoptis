Value Required COMPONENT (\S+(?:\s+\d+)?)
Value STATUS (OK|NOT OK|Absent|ALARM|CRIT|Normal|-)
Value VALUE ([+-]?\d+(?:\.\d+)?(?:%|C|V|A|W|RPM)?)
Value TYPE (Fan|Temperature|PSU|Sensor)

Start
  ^Fan\s+Status\s+Speed\s*$$ -> FanSection
  ^Temperature\s+Value.*$$ -> TemperatureSection
  ^PSU\s+Status\s+VIN.*$$ -> PsuSection
  ^${COMPONENT}\s+${STATUS}\s+${VALUE}.*$$ -> Record
  ^\s*$$ -> Continue

FanSection
  ^-+.*$$ -> Continue
  ^${COMPONENT}\s+${STATUS}\s+${VALUE}.*$$ -> Record
  ^\s*$$ -> Start

TemperatureSection
  ^-+.*$$ -> Continue
  ^${COMPONENT}\s+${VALUE}.*$$ -> Record
  ^\s*$$ -> Start

PsuSection
  ^-+.*$$ -> Continue
  ^${COMPONENT}\s+${STATUS}\s+${VALUE}.*$$ -> Record
  ^\s*$$ -> Start