# Asterfusion CLI - Environment Variables Template

# Authentication (Default Credentials)
# Used if the inventory file references environment variables instead of 
# hardcoded credentials.
ASTER_CLI_USERNAME="your_service_account_username"
ASTER_CLI_PASSWORD="your_super_secret_password"
# (Optional) Enable/Privilege EXEC password if required by the switch AAA config
ASTER_CLI_SECRET="your_enable_secret_if_applicable"

# Configuration Paths
# Path to the inventory file containing your switches
ASTER_CLI_INVENTORY_PATH="config/inventory.yaml"

# Path to the friendly-to-native command mappings
ASTER_CLI_COMMAND_MAP_PATH="config/command_map.yaml"

# Logging & Debugging
# Application log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
ASTER_CLI_LOG_LEVEL="INFO"

# Directory where Netmiko session logs (raw outputs) will be saved
ASTER_CLI_LOG_DIR="logs/"

# Set to "True" to enable verbose Netmiko debugging directly to the console
ASTER_CLI_NETMIKO_DEBUG="False"