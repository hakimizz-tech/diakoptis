# Asterfusion CLI (v2) - Environment Variables Template
# Copy this file to '.env' and fill in your actual secrets.
# NEVER commit the '.env' file to version control.

# Authentication (Credential Profiles)
# These must match the 'username_env' and 'password_env' values defined in 
# your config/inventory.yaml under 'credential_profiles'.

# Default Profile
ASTER_DEFAULT_USER="your_service_account"
ASTER_DEFAULT_PASS="your_super_secret_password"

# Admin/Privileged Profile (Example)
LEAF_ADMIN_USER="admin_user"
LEAF_ADMIN_PASS="admin_password"
ASTER_ENABLE_SECRET="your_enable_secret_if_applicable"

# Configuration Paths

# Path to the inventory file containing your switches and groups
INVENTORY_PATH="config/inventory.yaml"

# Path to the vendor-specific command map
COMMAND_MAP_PATH="config/command_map/asterfusion.yaml"

# Concurrency & Connections (v2)

# Maximum number of simultaneous SSH connections across your switch fleet.
# Lower this if running from a resource-constrained jump host or bastion.
MAX_CONCURRENT="20"

# SSH connection timeout in seconds.
SSH_TIMEOUT="15"

# Logging & Debugging

# Application log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL="INFO"

# Directory where audit logs and Netmiko session logs will be saved
LOG_DIR="logs/"

# Set to "True" to enable verbose Netmiko SSH debugging directly to the console
NETMIKO_DEBUG="False"